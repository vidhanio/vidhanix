diff --git a/waywall/server/wp_relative_pointer.c b/waywall/server/wp_relative_pointer.c
index 254ed83..8a0b734 100644
--- a/waywall/server/wp_relative_pointer.c
+++ b/waywall/server/wp_relative_pointer.c
@@ -35,8 +35,11 @@ on_relative_pointer_relative_motion(void *data, struct zwp_relative_pointer_v1 *
     double y = trunc(relative_pointer->acc_y);
     relative_pointer->acc_y -= y;
 
-    relative_pointer->acc_x_unaccel += wl_fixed_to_double(dx_unaccel);
-    relative_pointer->acc_y_unaccel += wl_fixed_to_double(dy_unaccel);
+    // SDL uses unaccelerated motion for relative mouse input by default (including 26.3).
+    // Apply the same multiplier here so sensitivity works regardless of which deltas the
+    // client consumes.
+    relative_pointer->acc_x_unaccel += wl_fixed_to_double(dx_unaccel) * relative_pointer->config.sens;
+    relative_pointer->acc_y_unaccel += wl_fixed_to_double(dy_unaccel) * relative_pointer->config.sens;
 
     double x_unaccel = trunc(relative_pointer->acc_x_unaccel);
     relative_pointer->acc_x_unaccel -= x_unaccel;
